{
  "name": "chat-app-root",
  "version": "1.0.0",
  "description": "Full-stack chat app workspace runner",
  "scripts": {
    "backend": "yarn --cwd backend start",
    "backend:dev": "yarn --cwd backend run dev",
    "frontend": "yarn --cwd frontend start",
    "frontend:build": "yarn --cwd frontend build",
    "build": "yarn --cwd frontend build",
    "install:all": "yarn --cwd backend install && yarn --cwd frontend install"
  }
}
