{
  "name": "chat-app-root",
  "version": "1.0.0",
  "description": "Full-stack chat app workspace runner",
  "scripts": {
    "backend": "npm --prefix backend start",
    "backend:dev": "npm --prefix backend run dev",
    "frontend": "npm --prefix frontend start",
    "frontend:build": "npm --prefix frontend run build",
    "install:all": "npm --prefix backend install && npm --prefix frontend install --legacy-peer-deps"
  }
}
